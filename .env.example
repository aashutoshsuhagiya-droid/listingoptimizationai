# Server-side image generation (never expose these values in browser code)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high
OPENAI_OUTPUT_FORMAT=webp
OPENAI_OUTPUT_COMPRESSION=90

# Product background removal (server only)
PHOTOROOM_API_KEY=your_photoroom_api_key_here
PHOTOROOM_SEGMENT_URL=https://sdk.photoroom.com/v1/segment
PHOTOROOM_FILE_FIELD=image_file

# Firebase Admin service account for API authentication and Firestore quotas
FIREBASE_PROJECT_ID=listing-optimization-ai
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-example@listing-optimization-ai.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Abuse and cost controls
REQUIRE_VERIFIED_EMAIL=true
REQUIRE_GENERATION_ENTITLEMENT=true
MAX_DAILY_GENERATIONS=6
GENERATION_COOLDOWN_SECONDS=5
MAX_DAILY_GLOBAL_GENERATIONS=100
MAX_DAILY_PRODUCT_PREPARATIONS=10
PRODUCT_PREPARATION_COOLDOWN_SECONDS=3
MAX_DAILY_GLOBAL_PRODUCT_PREPARATIONS=200

# Optional offline asset-pipeline fallback (not used by the customer studio)
REPLICATE_API_TOKEN=your_replicate_token_here
REPLICATE_MODEL=stability-ai/sdxl

# Pipeline defaults
IMAGE_PROVIDER=auto
IMAGE_OUTPUT_DIR=./images
IMAGE_QUALITY=high
IMAGE_FORMAT=png
MAX_FILE_SIZE_KB=500
IMAGE_RETRY_ATTEMPTS=3
