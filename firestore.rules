rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Quotas are server-owned. Firebase Admin bypasses these client rules.
    match /generationUsage/{document=**} {
      allow read, write: if false;
    }

    // This project currently has no browser-readable Firestore collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
